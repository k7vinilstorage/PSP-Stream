      "L": "BTN_RIGHT", "R": "BTN_LEFT",
      "START": "KEY_ESC", "SELECT": "KEY_TAB"
    },
    "analog": {"mode": "mouse", "speed": 900, "deadzone": 0.15, "curve": 2.0}
  },

  "desktop": {
    "buttons": {
      "UP": "KEY_UP", "DOWN": "KEY_DOWN", "LEFT": "KEY_LEFT", "RIGHT": "KEY_RIGHT",
