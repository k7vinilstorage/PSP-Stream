# Wolf + PSPStream settings (docker/compose*.yml and pspstream.yml).
# Copy to .env and adjust; in Portainer, use the same variables in the stack.
# After changing: docker compose up -d

# Which file "docker compose" uses in this folder: compose.yml (Intel/AMD),
# compose.nvidia.yml (NVIDIA) or pspstream.yml (Wolf already runs elsewhere).
COMPOSE_FILE=compose.yml

# PSPStream image. nightly = main; latest = the latest release; or
# pspstream:local (built here: docker compose -f ... -f build.yml build).
PSPSTREAM_IMAGE=ghcr.io/k7vinilstorage/pspstream:nightly

# How Wolf brings the image down from the GPU for the PSP: nvidia, va (Intel/AMD),
# cpu (Wolf with WOLF_USE_ZERO_COPY=FALSE) or auto (tries in that order, ~10 s per
# failed attempt). Empty: auto (compose.nvidia.yml: nvidia).
PSPSTREAM_VIDEO_CONVERT=

# What to mirror: empty = the only open lobby; or the lobby name (or id).
PSPSTREAM_WOLF_TARGET=
# Lobby PIN, if it asks for one (so the PSP controls can join).
PSPSTREAM_WOLF_PIN=
# PSP controls in the game: xbox, xbox-camera or xbox-shoulders (wiki, Controls).
PSPSTREAM_PROFILE=xbox

# Language of the server messages and the web interface: en (default) or pt.
# The web interface can also change it (saved in the pspstream-config volume).
PSPSTREAM_LANG=en

# Web interface. 127.0.0.1:5124 = on the server only; 0.0.0.0:5124 = on the
# local network (http://server-IP:5124), and then use a password.
PSPSTREAM_WEB=127.0.0.1:5124
PSPSTREAM_WEB_PASSWORD=
# Names accepted in the web interface address besides the server IP and name
# (e.g. a name from the router's DNS), comma separated.
PSPSTREAM_WEB_HOSTS=

# Wolf image.
WOLF_IMAGE=ghcr.io/games-on-whales/wolf:stable
# Only if you changed the ping ports in Wolf (its own variables).
WOLF_VIDEO_PING_PORT=48100
WOLF_AUDIO_PING_PORT=48200
