# Configurações do Wolf + PSPStream (docker/compose*.yml e pspstream.yml).
# Copie para .env e ajuste; no Portainer, use as mesmas variáveis na stack.
# Depois de mudar: docker compose up -d

# Qual arquivo o "docker compose" usa nesta pasta: compose.yml (Intel/AMD),
# compose.nvidia.yml (NVIDIA) ou pspstream.yml (o Wolf já roda em outro lugar).
COMPOSE_FILE=compose.yml

# Imagem do PSPStream. nightly = a main; latest = a última versão; ou
# pspstream:local (compilada aqui: docker compose -f ... -f build.yml build).
PSPSTREAM_IMAGE=ghcr.io/k7vinilstorage/pspstream:nightly

# Como o Wolf desce a imagem da GPU para o PSP: nvidia, va (Intel/AMD), cpu
# (Wolf com WOLF_USE_ZERO_COPY=FALSE) ou auto (tenta nessa ordem, ~10 s por
# tentativa que falha). Vazio: auto (compose.nvidia.yml: nvidia).
PSPSTREAM_VIDEO_CONVERT=

# O que espelhar: vazio = o único lobby aberto; ou o nome (ou id) do lobby.
PSPSTREAM_WOLF_TARGET=
# PIN do lobby, se ele pede (para os controles do PSP entrarem).
PSPSTREAM_WOLF_PIN=
# Controles do PSP no jogo: xbox, xbox-camera ou xbox-ombros (README, Controles).
PSPSTREAM_PROFILE=xbox

# Interface web. 127.0.0.1:5124 = só no servidor; 0.0.0.0:5124 = na rede
# local (http://IP-do-servidor:5124), e aí use uma senha.
PSPSTREAM_WEB=127.0.0.1:5124
PSPSTREAM_WEB_PASSWORD=
# Nomes aceitos no endereço da interface web além do IP (ex.: o domínio do
# Cloudflare Tunnel), separados por vírgula.
PSPSTREAM_WEB_HOSTS=

# Cloudflare Tunnel (opcional, só para a interface web): COMPOSE_PROFILES=cloudflare
# e o token do túnel (Cloudflare Zero Trust > Networks > Tunnels), com o
# "public hostname" apontando para http://localhost:5124.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# Imagem do Wolf.
WOLF_IMAGE=ghcr.io/games-on-whales/wolf:stable
# Só se você mudou as portas de ping no Wolf (as mesmas variáveis dele).
WOLF_VIDEO_PING_PORT=48100
WOLF_AUDIO_PING_PORT=48200
