# Serviço de usuário (não liga sozinho):
#   systemctl --user enable --now pspstream     # sobe junto com a sessão gráfica
#   journalctl --user -u pspstream -f           # o log
# Rode "pspstream" uma vez à mão antes, para escolher a tela no portal.
[Unit]
Description=PSPStream (PC screen and audio on the PSP)
Documentation=https://github.com/k7vinilstorage/PSP-Stream/wiki file:///usr/share/doc/pspstream/README.md
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
ExecStart=/usr/bin/pspstream
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
