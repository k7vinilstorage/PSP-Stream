# PSPStream: PC IP address on the first line (port optional, default 5123).
# Everything here can also be changed on the PSP's own settings screen,
# which writes this file (without the comments).
# Without an IP, the settings screen opens and waits: use "Find the PC on the network".
# 192.168.1.100

# Language of the PSP screens: en (default) | pt (Portuguese)
lang=en

# Network profile saved in Settings > Network Settings (1 = first)
wifi_profile=1

# auto = hardware decoder (sceJpeg) with software as a fallback
# hw | sw = force one of them. If the image comes out skewed or with wrong colors, use sw.
decoder=auto

# 1 = swap frames on vblank (no tearing, +0 to 16 ms)
vsync=1

# 1 = ask for the next frame before decoding the current one (network and decode in parallel)
prefetch=1

# 1 = show FPS, KB/frame, decode and network timings
overlay=1

# 1 = the PSP buttons and analog stick become keyboard/mouse on the PC
input=1

# udp | tcp. Measured on a PSP-3000, UDP never stalled and TCP stalled several times.
# With the stream running, SELECT+START+L switches and reconnects.
# (open both ports in the PC firewall: 5123/udp and 5123/tcp)
transport=udp

# UDP: ask for the next frame when this much of the current one is left, so it
# starts arriving right as the current one ends. auto = round trip x throughput,
# measured by the PSP (~2-3 KB on the PSP-3000). 0 = only after the whole frame
# (as up to v0.7). N = fixed at N KB; a fixed 6-14 KB asked too early and latency rose.
early_kb=auto

# UDP: how to wait for packets. auto = on connect, measures the round trip with
# select() and with polling the socket every 0.5 ms, and keeps the faster one.
# select | poll = force one.
rxwait=auto

# 1 = accept H.264 (server with --codec h264 or auto). 0 = JPEG only.
h264=1

# 1 = accept H.264 with P frames (server with --codec h264p): ~10x fewer bytes
# per frame, ~10.6 ms decode instead of ~3.7 ms. 0 = the server sends every frame as IDR.
h264p=1

# Socket receive buffer in KB. To experiment: 32, 64, 128
rcvbuf=64

# 1 = on connect, measure hw x sw decode on the PSP itself and show it on screen
bench=0

# Seconds with the settings screen open before connecting by itself
# (any button stops the countdown). 0 = connect right away; the screen still
# opens with SELECT + START + R during the stream.
menu_wait=3
