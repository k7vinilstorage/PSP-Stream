# PSPStream: IP do PC na primeira linha (porta opcional, padrão 5123)
192.168.1.100

# Perfil de rede salvo em Ajustes > Ajustes de rede (1 = primeiro)
wifi_profile=1

# auto = decoder de hardware (sceJpeg) com fallback para software
# hw | sw = forçar um deles. Se a imagem sair torta ou com cores erradas, use sw.
decoder=auto

# 1 = troca de quadro no vblank (sem rasgo na imagem, +0 a 16 ms)
vsync=1

# 1 = pede o próximo frame antes de decodificar o atual (rede e decode em paralelo)
prefetch=1

# 1 = mostra FPS, KB/frame, tempos de decode e rede
overlay=1

# 1 = os botões e o analógico do PSP viram teclado/mouse no PC
input=1

# udp | tcp. No PSP-3000 medido, o UDP não travou e o TCP travou várias vezes.
# Com o stream rodando, SELECT+START+L troca e reconecta.
# (libere as duas portas no firewall do PC: 5123/udp e 5123/tcp)
transport=udp

# UDP: pede o próximo frame quando faltarem N KB do atual, para o rádio não
# ficar parado esperando o pedido ir e voltar (~20 ms por frame). 0 = desligado.
# Ideal ~ (tempo de ida e volta) x (vazão): 10 no Wi-Fi medido.
early_kb=10

# Buffer de recepção do socket em KB. Para experimentar: 32, 64, 128
rcvbuf=64

# 1 = ao conectar, mede o decode hw x sw no próprio PSP e mostra na tela
bench=0
